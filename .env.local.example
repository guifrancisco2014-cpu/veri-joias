# Supabase — encontre esses valores em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — usado para enviar um e-mail quando uma reserva é feita.
# Crie uma conta gratuita em https://resend.com, gere uma API key
# e verifique o domínio (ou use o domínio de teste do Resend).
# Opcional: se não configurar, as reservas continuam sendo salvas
# normalmente, só não gera e-mail de notificação.
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=seuemail@exemplo.com
NOTIFICATION_EMAIL_FROM=onboarding@resend.dev
